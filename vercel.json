{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!_vercel).*)",
      "destination": "/index.py"
    }
  ],
  "functions": {
    "index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,error.log,todo.md,.git/**,logs/**,data/**,*.sqlite3}"
    }
  }
}
